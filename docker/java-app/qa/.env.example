# java-app / qa — non-secret runtime config.
# Copy to .env on the deploy box. spring.datasource.password is a SECRET and
# is deliberately absent here: deploy.sh pulls it from Secrets Manager
# (varunerp/java-app/qa) into .env.secrets on every deploy.

# application.properties resolves these with no defaults — an unset value
# fails startup loudly rather than silently using the wrong database.
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<db-user>
# SPRING_DATASOURCE_PASSWORD — from Secrets Manager, never written here.
