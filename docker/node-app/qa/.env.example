# node-app / qa — non-secret runtime config.
# Copy to .env on the deploy box. Real secrets are NEVER placed here:
# deploy.sh pulls them from Secrets Manager (varunerp/node-app/qa) into
# .env.secrets on every deploy, which docker-compose.yml also loads.

# Container-internal port. Host port (3001 dev / 3002 qa) is the NLB
# target_port and is set in docker-compose.yml, not here.
PORT=3000

# Drives the authorizer's env check in src/auth/pool-config.ts.
ENVIRONMENT=qa

# Cognito trust allowlist, keyed by pool ID — mirrors
# terraform/shared/cognito.tf's cognito_pool_map (ADR-0040).
# Pool IDs are account-specific; take them from Terraform's output.
POOL_MAP={"<cognito-pool-id>":{"group":"support","env":"qa"},"<cognito-pool-id>":{"group":"portal","env":"qa"}}

# Comma-separated, no spaces. Empty means no cross-origin caller is allowed.
CORS_ALLOWED_ORIGINS=https://<cloudfront-or-custom-domain>
