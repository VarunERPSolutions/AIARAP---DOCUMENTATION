route53_zone_id      = "Z0123456789ABCDEFGHIJ"
cognito_user_pool_id = "us-east-1_XXXXXXXXX"
api_ids = {
  node = "abc123defg"
}

tenants = {
  # Standard Tenant — default 2 connections x 3 environments, default throttle.
  acme = {}

  # Tenant with only the Salesforce-facing connection, no SAP integration yet.
  globex = {
    connections = [
      { key = "sf-node", backend = "node" },
    ]
  }

  # Higher-volume Tenant — bump prod limits for their SAP connection.
  initech = {
    throttle_overrides = {
      "sap-node-prd" = { rate_limit = 50, burst_limit = 100, quota_limit = 250000 }
    }
  }
}
